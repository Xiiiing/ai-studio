+    const relative = prefix && raw.startsWith(prefix) ? raw.slice(prefix.length) : '';
+    const allowed = /^v[1-9][0-9]*-[a-f0-9]{12}(?:-retry-[0-9]+)?\/[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$/.test(relative);
+    const url = !stale && allowed ? safeUrl(raw) : '';
