[Unit]
Description=AI Drama Factory Durable Production Worker
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
UMask=0077
EnvironmentFile=-@PROJECT_ROOT@/config/runtime.env
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/envs/factory/bin/python -u -m factory.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
Environment=LANGSMITH_TRACING=false
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
