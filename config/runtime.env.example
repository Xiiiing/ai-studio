# Copy to config/runtime.env and chmod 600. systemd reads this file.
# Only enable variables for services that you deliberately configure.
# DRAMA_COMFY_HOME=/srv/ComfyUI
# DRAMA_GPU_LOCK_DIR=/srv/gpu-locks
