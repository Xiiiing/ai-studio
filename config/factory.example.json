    "lm_studio_example": {
      "provider": "lm_studio",
      "enabled": false,
      "network_mode": "loopback",
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "replace-with-served-model-id",
      "context_tokens": 32768,
      "vision": false
    },
    "deepseek_example": {
      "provider": "deepseek",
      "enabled": false,
      "network_mode": "remote",
      "allowed_hosts": [
        "api.deepseek.com"
      ],
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-chat",
      "api_key_env": "DEEPSEEK_API_KEY",
      "context_tokens": 32768,
      "vision": false
