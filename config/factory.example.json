      "provider": "minimax",
      "enabled": false,
      "network_mode": "remote",
      "allowed_hosts": [
        "api.minimax.io"
      ],
      "base_url": "https://api.minimax.io/v1",
      "model": "MiniMax-Hailuo-2.3",
      "api_key_env": "MINIMAX_API_KEY",
      "duration": 6,
      "resolution": "768P",
      "download_hosts": [],
      "prompt_optimizer": false,
      "request_timeout_seconds": 60,
      "poll_interval_seconds": 5,
      "max_wait_seconds": 1800
