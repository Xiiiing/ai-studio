{
  "schema_version": 1,
  "llm": {
    "provider": "llama_cpp",
    "enabled": true,
    "network_mode": "loopback",
    "base_url": "http://127.0.0.1:8090/v1",
    "model": "drama-writer",
    "context_tokens": 32768,
    "vision": true,
    "response_format": "llama_json_schema",
    "context_validation": "llama_tokenize",
    "request_timeout_seconds": 480,
    "chat_template_kwargs": {
      "enable_thinking": false
    }
  },
  "creative": {
    "max_review_rounds": 4,
    "separate_storyboard": true
  },
  "research": {
    "provider": "google_news_rss",
    "max_sources": 8,
    "timeout_seconds": 15
  },
  "production": {
    "gpu_cards": [
      0
    ],
    "image_min_free_mib": 15000,
    "gpu_min_free_mib": 15000,
    "max_gpu_workers": 1,
    "max_parallel": 1,
    "max_attempts": 3,
    "h3_prompting": "automatic",
    "review_only_existing_videos": true,
    "max_wall_seconds": 10800,
    "max_gpu_seconds": 7200,
    "image_width": 736,
    "image_height": 1312,
    "output_width": 720,
    "output_height": 1280,
    "comfy_start_port": 8340,
    "video_profile": "fastwan"
  },
  "web": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "quality": {
    "semantic_enabled": true,
    "minimum_score": 60
  },
  "optimization": {
    "strategy": "render_evaluate_repair",
    "dspy_enabled": false,
    "vbench_enabled": false
  },
  "llm_profiles": {
    "writer_local": {
      "provider": "llama_cpp",
      "enabled": true,
      "network_mode": "loopback",
      "base_url": "http://127.0.0.1:8090/v1",
      "model": "drama-writer",
      "context_tokens": 32768,
      "vision": true,
      "response_format": "llama_json_schema",
      "context_validation": "llama_tokenize",
      "request_timeout_seconds": 480,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "critic_local": {
      "provider": "llama_cpp",
      "enabled": true,
      "network_mode": "loopback",
      "base_url": "http://127.0.0.1:8092/v1",
      "model": "drama-critic",
      "context_tokens": 32768,
      "vision": false,
      "response_format": "llama_json_schema",
      "context_validation": "llama_tokenize",
      "request_timeout_seconds": 480,
      "chat_template_kwargs": {
        "enable_thinking": false
      },
      "temperature_override": 0.25,
      "top_p": 0.8
    },
    "ollama_example": {
      "provider": "ollama",
