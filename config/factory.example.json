      "context_tokens": 32768,
      "vision": false,
      "thinking": false,
      "model_discovery": "skip"
    }
  },
  "llm_roles": {
    "researcher": "writer_local",
    "creator": "writer_local",
    "story_editor": "writer_local",
    "story_critic": "critic_local",
    "screenwriter": "writer_local",
    "storyboard_director": "writer_local",
    "independent_critic": "critic_local",
    "visual_designer": "writer_local",
    "prompt_style_compiler": "writer_local",
    "visual_critic": "writer_local",
    "dialogue_editor": "writer_local",
    "edit_director": "writer_local"
  },
  "video_profiles": {
